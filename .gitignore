# Transient files
*.lock
*.tmp
*.bak
.cs-tmp.*

# Per-actor local state (never shared)
.cs/local/

# The session's locks, by name as well as by *.lock: the rules
# ensure_cs_gitignore_entries looks for
.cs/session.lock
.cs/session.mutex.lock

# A session's cs files when a .cs/private directory holds them (the link an
# encrypted session keeps there is committed; a directory is not)
.cs/private/

# Session archives (large binaries; unrelated to the tracked .cs/archived marker)
.cs/archives/

# An encrypted session's mounted volume (never staged in plaintext)
.cs/vault-mnt/

# Session cooldown markers
.cs/.narrative-reminder-cooldown

# Claude Code local settings (recreated by cs on each machine)
.claude/settings.local.json

# cs session protocol (machine-local; regenerated by cs on each machine)
CLAUDE.local.md

# OS files
.DS_Store
Thumbs.db

# Editor and tool config
.vscode/
.idea/
.obsidian/
*.swp
*.swo
*~

# Generated app, Swift package, and Python test artifacts
.build/
.swiftpm/
dist/
__pycache__/
*.pyc
